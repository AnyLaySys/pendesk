#!/bin/sh
bin=${0%/*}
slot=${bin%/*}
package=${slot%/*}
data="$package/data"
if [ "${1:-}" = input ]; then
    if [ -p "$data/input.fifo" ]; then
        exec 3<> "$data/input.fifo"
        printf '%b' "$2" >&3
        exec 3>&-
    fi
    exit
fi
set -eu
umask 077
config="$data/config"
device_list=/userdisk/PenDesk/CtrlDev
if [ "${1:-}" = files ]; then
    action=${2:-}
    case "$action" in
        reset|transfer/push|transfer/pull) ;;
        open/pen/*|open/windows/*|select/pen/*|select/windows/*)
            case "${action##*/}" in ''|*[!0-9]*) exit 2 ;; esac
            ;;
        *) exit 2 ;;
    esac
    timeout=15
    case "$action" in
        transfer/*)
            /bin/setsid curl -fsS --max-time 600 "http://127.0.0.1:999/files/$action" < /dev/null > /dev/null 2>&1 &
            ;;
        *)
            curl -fsS --max-time "$timeout" "http://127.0.0.1:999/files/$action" < /dev/null > /dev/null 2>&1 || :
            ;;
    esac
    exit
fi
alive() {
    pid=$(cat "$1" 2>/dev/null) || return 1
    case "$pid" in ''|*[!0-9]*) return 1 ;; esac
    [ "$pid" -gt 1 ] && [ -r "/proc/$pid/stat" ] || return 1
    case "$1" in
        "$data/pdd.pid") expected=pdd ;;
        "$data/tailscaled.pid") expected=tailscaled ;;
        *) return 1 ;;
    esac
    case "$(readlink "/proc/$pid/exe")" in
        "$package/a/bin/$expected"|"$package/b/bin/$expected"|\
        "$package/a/bin/$expected (deleted)"|"$package/b/bin/$expected (deleted)") ;;
        *) return 1 ;;
    esac
    [ "$(cut -d ' ' -f 3 "/proc/$pid/stat")" != Z ]
}
write_devices() {
    active=
    if [ -s "$config" ]; then active=$(sed -n 's/^host=//p' "$config"); fi
    : > "$device_list"
    for profile in "$data"/device-*.conf; do
        [ -f "$profile" ] || continue
        device=${profile##*/}
        device=${device#device-}
        device=${device%.conf}
        if [ "$device" = "$active" ]; then printf '*' >> "$device_list"; fi
        printf '%s\n' "$device" >> "$device_list"
    done
    chmod 644 "$device_list"
}
stop() {
    if alive "$1"; then
        kill "$pid" 2>/dev/null || :
        stopping=0
        while alive "$1" && [ "$stopping" -lt 40 ]; do
            sleep 0.1
            stopping=$((stopping + 1))
        done
        if alive "$1"; then kill -9 "$pid" 2>/dev/null || :; fi
    fi
    rm -f "$1"
}
network() {
    if alive "$data/tailscaled.pid" && [ -S "$data/tailscaled.sock" ]; then return; fi
    stop "$data/pdd.pid"
    stop "$data/tailscaled.pid"
    rm -f "$data/tailscaled.pid" "$data/tailscaled.sock"
    socks=127.0.0.1:1055
    if [ -s "$config" ]; then socks=$(sed -n 's/^socks=//p' "$config"); fi
    HOME="$data" XDG_CACHE_HOME="$data" /bin/setsid "$bin/tailscaled" --no-logs-no-support --tun=userspace-networking --state="$data/tailscaled.state" --socket="$data/tailscaled.sock" --socks5-server="$socks" < /dev/null > /dev/null 2>&1 &
    echo $! > "$data/tailscaled.pid"
    count=0
    while [ ! -S "$data/tailscaled.sock" ] && [ "$count" -lt 50 ]; do
        sleep 0.1
        count=$((count + 1))
    done
    [ -S "$data/tailscaled.sock" ]
}
initialize() {
    old=
    if [ -r "$data/slot" ]; then
        old=$(cat "$data/slot")
    fi
    if [ "$old" != "$slot" ]; then
        stop "$data/pdd.pid"
        stop "$data/tailscaled.pid"
        rm -f "$data/tailscaled.sock"
    fi
    if [ ! -f "$config" ]; then
        for candidate in "$slot/config" "$old/config"; do
            case "$candidate" in "$package"/*/config) ;; *) continue ;; esac
            if [ -s "$candidate" ]; then
                cp "$candidate" "$config"
                chmod 600 "$config"
                break
            fi
        done
    fi
    mkdir -p /userdisk/PenDesk
    chmod 755 /userdisk/PenDesk
    if [ -s "$config" ]; then
        device=$(sed -n 's/^host=//p' "$config")
        if [ -n "$device" ] && [ ! -f "$data/device-$device.conf" ]; then
            cp "$config" "$data/device-$device.conf"
            chmod 600 "$data/device-$device.conf"
            write_devices
        elif [ -n "$device" ] && [ ! -f "$device_list" ]; then
            write_devices
        fi
    fi
    [ -f "$device_list" ] && chmod 644 "$device_list"
    printf '%s\n' "$slot" > "$data/slot"
    chmod 755 "$bin/pdd" "$bin/pdc" "$bin/tailscale" "$bin/tailscaled"
    chmod 755 "$bin/adb-guard"
    /bin/setsid "$bin/adb-guard" "$data" < /dev/null > /dev/null 2>&1 &
}
serve_adb() {
    HOME="$data" "$bin/tailscale" --socket="$data/tailscaled.sock" serve --bg --tcp=5555 tcp://127.0.0.1:5555 > /dev/null 2>&1 || :
}
run() {
    network || :
    serve_adb
    [ -s "$config" ] || return 0
    "$bin/pdd" --check-config "$config"
    if ! alive "$data/pdd.pid"; then
        rm -f "$data/pdd.pid"
        /bin/setsid "$bin/pdd" --config "$config" < /dev/null > /dev/null 2>&1 &
        echo $! > "$data/pdd.pid"
    fi
}
if [ "${1:-}" = stop ]; then
    stop "$data/pdd.pid"
    stop "$data/tailscaled.pid"
    rm -f "$data/tailscaled.sock" "$data/input.fifo"
    exit
fi
mkdir -p "$data"
chmod 700 "$data"
initialize
case "${1:-}" in
    devices)
        cat "$device_list"
        exit
        ;;
    switch-device)
        [ "$#" -eq 2 ] || exit 2
        device=$2
        case "$device" in 100.*) ;; *) exit 2 ;; esac
        case "$device" in *[!0-9.]*|*..*) exit 2 ;; esac
        profile="$data/device-$device.conf"
        [ -s "$profile" ] || exit 2
        "$bin/pdd" --check-config "$profile"
        cp "$profile" "$data/config.new"
        stop "$data/pdd.pid"
        mv "$data/config.new" "$config"
        write_devices
        run
        exit
        ;;
esac
case "${1:-}" in
    network) network ;;
    restart) stop "$data/pdd.pid"; run ;;
    status)
        network
        HOME="$data" exec "$bin/tailscale" --socket="$data/tailscaled.sock" status --json
        ;;
    wake)
        [ "$#" -eq 2 ] || exit 2
        case "$2" in 100.*) ;; *) exit 2 ;; esac
        network
        curl -fsS --max-time 5 --socks5-hostname 127.0.0.1:1055 -X POST "http://$2:8765/wake" > /dev/null
        ;;
    login)
        network
        if [ -s "$data/auth" ]; then
            result=0
            HOME="$data" /bin/timeout 20 "$bin/tailscale" --socket="$data/tailscaled.sock" up --timeout=15s --auth-key="file:$data/auth" || result=$?
            rm -f "$data/auth"
            [ "$result" -eq 0 ] || exit "$result"
        else
            HOME="$data" /bin/timeout 20 "$bin/tailscale" --socket="$data/tailscaled.sock" up --timeout=15s || :
        fi
        run
        ;;
    configure)
        chmod 600 "$data/config.new"
        "$bin/pdd" --check-config "$data/config.new"
        device=$(sed -n 's/^host=//p' "$data/config.new")
        case "$device" in 100.*) ;; *) exit 2 ;; esac
        cp "$data/config.new" "$data/device-$device.conf"
        chmod 600 "$data/device-$device.conf"
        stop "$data/pdd.pid"
        stop "$data/tailscaled.pid"
        mv "$data/config.new" "$config"
        write_devices
        ;;
    "") run > /dev/null 2>&1 ;;
    *) exit 2 ;;
esac
